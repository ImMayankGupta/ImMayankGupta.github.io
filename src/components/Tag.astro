---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  count?: number;
  size?: "sm" | "base" | "lg";
};

const { tag, tagName, count, size = "base" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li class="inline-block">
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    class:list={[
      "group border-border bg-muted/40 inline-flex items-center gap-1.5 rounded-md border font-medium transition-all",
      "hover:border-accent hover:bg-accent/10 hover:text-accent hover:-translate-y-0.5",
      size === "sm" && "px-2.5 py-1 text-xs",
      size === "base" && "px-3.5 py-1.5 text-sm",
      size === "lg" && "px-4 py-2 text-base",
    ]}
  >
    <IconHash
      class:list={[
        "text-accent/80 group-hover:text-accent transition-colors",
        size === "sm" && "size-3",
        size === "base" && "size-3.5",
        size === "lg" && "size-4",
      ]}
    />
    <span>{tagName}</span>
    {
      typeof count === "number" && (
        <span class="bg-background/80 text-foreground/60 group-hover:text-accent rounded px-1.5 py-0.5 text-xs">
          {count}
        </span>
      )
    }
  </a>
</li>
