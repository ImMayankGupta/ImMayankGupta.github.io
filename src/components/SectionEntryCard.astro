---
import Datetime from "./Datetime.astro";

type Props = {
  href: string;
  title: string;
  description: string;
  pubDatetime: Date;
  updatedDatetime?: Date;
  tags?: string[];
};

const {
  href,
  title,
  description,
  pubDatetime,
  updatedDatetime,
  tags = [],
} = Astro.props;
---

<li class="my-6">
  <a
    href={href}
    class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
  >
    <h3>{title}</h3>
  </a>
  <Datetime pubDatetime={pubDatetime} modDatetime={updatedDatetime ?? null} />
  <p class="mt-1">{description}</p>
  {
    tags.length > 0 && (
      <ul class="mt-2 flex flex-wrap gap-2">
        {tags.map(tag => (
          <li class="border-border text-foreground/70 rounded border px-2 py-0.5 text-xs">
            #{tag}
          </li>
        ))}
      </ul>
    )
  }
</li>
