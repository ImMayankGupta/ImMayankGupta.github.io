---
import { getRelativeLocaleUrl } from "astro:i18n";
import "swiper/css";
import config from "@/config";

type Entry = {
  id: string;
  data: {
    title: string;
    description: string;
    pubDatetime: Date;
    tags: string[];
    featured?: boolean;
  };
};

type Props = {
  entries: Entry[];
  section: "automation" | "interview" | "resources";
  /** Number of entries to show in the featured list or carousel. Default 3. */
  featuredCount?: number;
};

const { entries, section, featuredCount = 3 } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;

const featured = [...entries]
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime();
  })
  .slice(0, featuredCount);

const count = featured.length;
const useCarousel = count > 3;

const cardClass =
  "group border-accent bg-background flex h-56 flex-col rounded-lg border p-6 transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-accent/20";

const gridClass = [
  "grid gap-6 auto-rows-fr",
  count === 1 && "sm:grid-cols-1 sm:max-w-md sm:mx-auto",
  count === 2 && "sm:grid-cols-2",
  count === 3 && "sm:grid-cols-3",
]
  .filter(Boolean)
  .join(" ");
---

{
  count === 0 && (
    <p class="text-foreground/70">No entries yet — check back soon.</p>
  )
}

{
  !useCarousel && count > 0 && (
    <div class={gridClass}>
      {featured.map(e => (
        <a
          href={getRelativeLocaleUrl(locale, `${section}/${e.id}`)}
          class={cardClass}
        >
          <div class="flex flex-col items-center gap-4 text-center">
            <img
              src="/icon2.png"
              alt="section icon"
              class="h-10 w-10 object-contain"
            />
            <h3 class="group-hover:text-accent text-lg leading-snug font-bold transition-colors">
              {e.data.title}
            </h3>
          </div>
          <div class="text-accent mt-auto text-sm font-medium opacity-0 transition-opacity group-hover:opacity-100">
            Read more →
          </div>
        </a>
      ))}
    </div>
  )
}

{
  useCarousel && (
    <div class="carousel-root" data-count={count}>
      <div class="flex items-center gap-2 sm:gap-4">
        <button
          class="carousel-prev border-border hover:border-accent hover:text-accent bg-background flex size-10 shrink-0 items-center justify-center rounded-full border text-lg font-semibold shadow-sm transition-colors disabled:cursor-not-allowed disabled:opacity-30 sm:size-12"
          aria-label="Previous slide"
        >
          ←
        </button>

        <div class="swiper carousel-viewport min-w-0 flex-1 overflow-hidden">
          <div class="swiper-wrapper">
            {featured.map(e => (
              <div class="swiper-slide">
                <a
                  href={getRelativeLocaleUrl(locale, `${section}/${e.id}`)}
                  class={cardClass}
                >
                  <div class="flex flex-col items-center gap-4 text-center">
                    <img
                      src="/icon2.png"
                      alt="section icon"
                      class="h-10 w-10 object-contain"
                    />
                    <h3 class="group-hover:text-accent text-lg leading-snug font-bold transition-colors">
                      {e.data.title}
                    </h3>
                  </div>
                  <div class="text-accent mt-auto text-sm font-medium opacity-0 transition-opacity group-hover:opacity-100">
                    Read more →
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>

        <button
          class="carousel-next border-border hover:border-accent hover:text-accent bg-background flex size-10 shrink-0 items-center justify-center rounded-full border text-lg font-semibold shadow-sm transition-colors disabled:cursor-not-allowed disabled:opacity-30 sm:size-12"
          aria-label="Next slide"
        >
          →
        </button>
      </div>

      <div class="carousel-dots mt-6 flex justify-center gap-2" />
    </div>
  )
}

<script>
  import Swiper from "swiper";
  import {
    Navigation,
    Pagination,
    Autoplay,
    Keyboard,
    A11y,
  } from "swiper/modules";
  import "swiper/css";

  const init = () => {
    document.querySelectorAll<HTMLElement>(".carousel-root").forEach(root => {
      if (root.dataset.initialized === "true") return;
      root.dataset.initialized = "true";

      const viewport = root.querySelector<HTMLElement>(".carousel-viewport");
      const prevEl = root.querySelector<HTMLElement>(".carousel-prev");
      const nextEl = root.querySelector<HTMLElement>(".carousel-next");
      const dotsEl = root.querySelector<HTMLElement>(".carousel-dots");
      if (!viewport || !prevEl || !nextEl || !dotsEl) return;

      const count = Number(root.dataset.count ?? 0);

      new Swiper(viewport, {
        modules: [Navigation, Pagination, Autoplay, Keyboard, A11y],
        slidesPerView: 1,
        slidesPerGroup: 1,
        spaceBetween: 16,
        loop: count > 3,
        keyboard: { enabled: true },
        autoplay: {
          delay: 5000,
          pauseOnMouseEnter: true,
          disableOnInteraction: false,
        },
        navigation: { prevEl, nextEl },
        pagination: {
          el: dotsEl,
          clickable: true,
          bulletClass: "carousel-dot",
          bulletActiveClass: "carousel-dot--active",
          renderBullet: (_i, className) =>
            `<button class="${className}" aria-label="Go to slide"></button>`,
        },
        breakpoints: {
          640: { slidesPerView: 2, spaceBetween: 20 },
          1024: { slidesPerView: 3, spaceBetween: 24 },
        },
      });
    });
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style is:global>
  .carousel-root .swiper {
    width: 100%;
    overflow: hidden;
  }

  .carousel-root .swiper-wrapper {
    display: flex !important;
    flex-direction: row !important;
    width: 100%;
    box-sizing: content-box;
  }

  .carousel-root .swiper-slide {
    display: flex !important;
    flex-shrink: 0 !important;
    width: 100%;
    height: auto;
  }

  .carousel-root .swiper-slide a {
    width: 100%;
  }

  .carousel-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-foreground);
    opacity: 0.3;
    border: 0;
    cursor: pointer;
    transition:
      width 0.2s,
      opacity 0.2s,
      background 0.2s;
  }
  .carousel-dot--active {
    width: 1.5rem;
    opacity: 1;
    background: var(--color-accent);
  }
</style>
