---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionEntryCard from "@/components/SectionEntryCard.astro";
import config from "@/config";

const entries = (
  await getCollection("resources", ({ data }) => !data.draft)
).sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`Resources | ${config.site.title}`}
  description="Free APIs, AI tools, datasets, and developer resources — curated for QA & engineering."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Resources"
    pageDesc="Free APIs, AI tools, datasets, and utilities I actually use."
  >
    {
      entries.length === 0 ? (
        <p class="text-foreground/70">No entries yet — check back soon.</p>
      ) : (
        <ul>
          {entries.map(e => (
            <SectionEntryCard
              href={getRelativeLocaleUrl(locale, `resources/${e.id}`)}
              title={e.data.title}
              description={e.data.description}
              pubDatetime={e.data.pubDatetime}
              updatedDatetime={e.data.updatedDatetime}
              tags={e.data.tags}
              externalUrl={e.data.externalUrl}
            />
          ))}
        </ul>
      )
    }
  </Main>
  <Footer />
</Layout>
