---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import SectionCard from "@/components/SectionCard.astro";
import SectionCarousel from "@/components/SectionCarousel.astro";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const homePath = getRelativeLocaleUrl(locale, "");

const [automation, resources, interview] = await Promise.all([
  getCollection("automation", ({ data }) => !data.draft),
  getCollection("resources", ({ data }) => !data.draft),
  getCollection("interview", ({ data }) => !data.draft),
]);

const sortByDate = <T extends { data: { pubDatetime: Date } }>(list: T[]) =>
  [...list].sort(
    (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
  );

const automationEntries = sortByDate(automation);
const resourcesEntries = sortByDate(resources);
const interviewEntries = sortByDate(interview);

const sections = [
  {
    href: getRelativeLocaleUrl(locale, "automation"),
    title: "Automation",
    tagline: "Frameworks & test engineering",
    emoji: "🤖",
    items: ["Playwright", "Selenium", "API Testing", "CI/CD Pipelines"],
  },
  {
    href: getRelativeLocaleUrl(locale, "resources"),
    title: "Resources",
    tagline: "Free tools for developers & QA",
    emoji: "📚",
    items: ["APIs", "AI APIs", "Datasets", "Tools"],
  },
  {
    href: getRelativeLocaleUrl(locale, "interview"),
    title: "Interview",
    tagline: "Questions, answers & practice",
    emoji: "💡",
    items: ["Questions", "Answers", "Practice", "System Design"],
  },
];
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <!-- ============ HERO ============ -->
    <section
      id="hero"
      class="border-border relative flex min-h-[80vh] flex-col justify-center gap-8 border-b pt-8 pb-16 lg:flex-row lg:items-center lg:gap-12"
    >
      <div class="flex flex-1 flex-col lg:max-w-2xl">
        <p class="text-accent mb-3 text-lg font-medium">Hi, My Name is</p>
        <h1
          class="mb-2 text-5xl leading-tight font-bold tracking-tight sm:text-7xl"
        >
          Mayank Gupta
        </h1>
        <h2
          class="text-foreground/60 mb-6 text-3xl leading-tight font-bold tracking-tight sm:text-5xl"
        >
          I build <span class="text-accent">TestWithAI</span>.
        </h2>
        <p class="text-foreground/80 text-lg leading-relaxed">
          QA Automation Architect turning quality engineering into scalable
          frameworks, AI-powered solutions, developer resources, and
          interview-ready knowledge — through
          <a
            href="https://github.com/TestWithAI"
            class="text-accent underline decoration-dashed underline-offset-4 hover:no-underline"
            target="_blank">TestWithAI</a
          > organization.
        </p>

        {
          /* Social Links - To be added later
          socials.length > 0 && (
            <div class="mt-8 flex max-sm:flex-col sm:items-center">
              <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                {t.home.socialLinks}:
              </div>
              <Socials />
            </div>
          )
        */
        }

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="#sections"
            class="border-accent bg-accent text-background hover:bg-accent/90 rounded-md border px-6 py-3 font-medium shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md"
          >
            Explore My Work
          </a>
          <a
            href="#contact"
            class="border-border hover:border-accent hover:text-accent rounded-md border px-6 py-3 font-medium transition-colors"
          >
            Get in touch
          </a>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="flex flex-1 items-center justify-center lg:justify-end">
        <img
          src="/mayank-logo.png"
          alt="Mayank - SDET & Automation Engineer"
          class="float-animation w-full max-w-sm object-cover"
          loading="lazy"
        />
      </div>

      <a
        href="#whoami"
        aria-label="Scroll to Who am I"
        class="text-foreground/40 hover:text-accent absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 5v14M19 12l-7 7-7-7"></path>
        </svg>
      </a>
    </section>

    <!-- ============ WHO AM I ============ -->
    <section id="whoami" class="border-border border-b py-16">
      <h2
        class="after:bg-accent mb-8 inline-block text-3xl font-bold tracking-wide after:mt-2 after:block after:h-1 after:w-16 after:rounded after:content-['']"
      >
        Who am I?
      </h2>
      <div class="grid gap-8 md:grid-cols-[1fr_2fr] md:items-start">
        <div class="relative">
          <img
            src={`${import.meta.env.BASE_URL}mayank-hero.png`}
            alt="Mayank Gupta"
            width="600"
            height="800"
            loading="lazy"
            class="border-border w-full rounded-lg border object-cover shadow-lg"
          />
        </div>
        <div class="space-y-4">
          <div class="text-foreground/85 space-y-4 text-base leading-relaxed">
            <p>
              I'm <strong>Mayank</strong> — a Software Development Engineer in Test
              (SDET) passionate about building automation frameworks, open-source
              developer tools, and sharing knowledge with the QA community.
            </p>
            <p>
              Through <strong>TestWithAI</strong>, I curate and publish
              battle-tested automation frameworks, free developer resources, and
              interview prep content designed to help engineers grow faster.
            </p>
            <p>
              When I'm not writing tests, I'm writing about how to write better
              tests. Explore the sections below to see what I've built.
            </p>
          </div>
          <div class="border-border bg-muted/30 mt-6 rounded-lg border p-6">
            <div class="mb-3 text-sm font-semibold tracking-wide uppercase">
              Skills
            </div>
            <ul class="grid gap-1.5 text-sm sm:grid-cols-2">
              <li>▸ Playwright / Cypress / Selenium</li>
              <li>▸ REST & GraphQL API Testing</li>
              <li>▸ CI/CD (GitHub Actions, Jenkins)</li>
              <li>▸ JavaScript / TypeScript / Python</li>
              <li>▸ Docker & Cloud Testing Grids</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ WHAT I DO / 3 SECTIONS ============ -->
    <section id="sections" class="border-border border-b py-16">
      <h2
        class="after:bg-accent mb-2 inline-block text-3xl font-bold tracking-wide after:mt-2 after:block after:h-1 after:w-16 after:rounded after:content-['']"
      >
        What I Do
      </h2>
      <p class="text-foreground/70 mt-4 mb-8">
        Three focused pillars under the TestWithAI umbrella.
      </p>
      <div class="grid gap-6 md:grid-cols-3">
        {sections.map(s => <SectionCard {...s} />)}
      </div>
    </section>

    <!-- ============ LATEST AUTOMATION ============ -->
    {
      automationEntries.length > 0 && (
        <section id="latest-automation" class="border-border border-b py-16">
          <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="after:bg-accent inline-block text-3xl font-bold tracking-wide after:mt-2 after:block after:h-1 after:w-16 after:rounded after:content-['']">
              🤖 Latest QA Automation Frameworks
            </h2>
            <a
              href={getRelativeLocaleUrl(locale, "automation")}
              class="text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              View all {automationEntries.length} →
            </a>
          </div>
          <SectionCarousel entries={automationEntries} section="automation" />
        </section>
      )
    }

    <!-- ============ LATEST INTERVIEW ============ -->
    {
      interviewEntries.length > 0 && (
        <section id="latest-interview" class="border-border border-b py-16">
          <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="after:bg-accent inline-block text-3xl font-bold tracking-wide after:mt-2 after:block after:h-1 after:w-16 after:rounded after:content-['']">
              💡 Latest Interview Questions
            </h2>
            <a
              href={getRelativeLocaleUrl(locale, "interview")}
              class="text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              View all {interviewEntries.length} →
            </a>
          </div>
          <SectionCarousel
            entries={interviewEntries}
            section="interview"
            featuredCount={3}
          />
        </section>
      )
    }

    <!-- ============ LATEST RESOURCES ============ -->
    {
      resourcesEntries.length > 0 && (
        <section id="latest-resources" class="border-border border-b py-16">
          <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="after:bg-accent inline-block text-3xl font-bold tracking-wide after:mt-2 after:block after:h-1 after:w-16 after:rounded after:content-['']">
              📚 Latest Open Source Resources
            </h2>
            <a
              href={getRelativeLocaleUrl(locale, "resources")}
              class="text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              View all {resourcesEntries.length} →
            </a>
          </div>
          <SectionCarousel entries={resourcesEntries} section="resources" />
        </section>
      )
    }

    <!-- ============ CONTACT ============ -->
    <section id="contact" class="py-16">
      <h2
        class="after:bg-accent mb-2 inline-block text-3xl font-bold tracking-wide after:mt-2 after:block after:h-1 after:w-16 after:rounded after:content-['']"
      >
        Let's connect
      </h2>
      <p
        class="text-foreground/80 mt-4 mb-6 max-w-2xl text-base leading-relaxed"
      >
        Have an idea, opportunity, or want to collaborate on an open-source
        testing project? I'd love to hear from you.
      </p>
      {socials.length > 0 && <Socials />}
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
