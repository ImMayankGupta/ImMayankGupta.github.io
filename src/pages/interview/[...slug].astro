---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Datetime from "@/components/Datetime.astro";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

export const getStaticPaths = (async () => {
  const entries = await getCollection("interview", ({ data }) => !data.draft);
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`${entry.data.title} | Interview`}
  description={entry.data.description}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={entry.data.title} pageDesc={entry.data.description}>
    <div class="text-foreground/70 mb-8 flex items-center gap-4 text-sm">
      <Datetime
        pubDatetime={entry.data.pubDatetime}
        modDatetime={entry.data.updatedDatetime ?? null}
      />
    </div>
    {
      entry.data.tags.length > 0 && (
        <div class="mb-8 flex flex-wrap gap-2">
          {entry.data.tags.map(tag => (
            <a
              href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}/`)}
              class="border-border text-foreground/70 hover:border-accent hover:text-accent rounded border px-3 py-1 text-sm transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }
    <article class="app-prose">
      <Content />
    </article>
  </Main>
  <Footer />
</Layout>
