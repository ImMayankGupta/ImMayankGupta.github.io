---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
// import SectionCarousel from "@/components/SectionCarousel.astro"; // Removed - showing all cards instead
// import SectionEntryCard from "@/components/SectionEntryCard.astro"; // Removed - using custom grid layout
import config from "@/config";

const entries = (
  await getCollection("interview", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());

const locale = Astro.currentLocale ?? config.site.lang;
const totalCount = entries.length;
---

<Layout
  title={`Interview | ${config.site.title}`}
  description="Interview questions, answers, and practice — QA, SDET and testing strategy."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Interview"
    pageDesc="Questions, answers and practice for QA / SDET interviews."
  >
    {
      totalCount === 0 ? (
        <p class="text-foreground/70">No entries yet — check back soon.</p>
      ) : (
        <>
          {/* Featured Carousel - Removed
          <section aria-labelledby="featured-heading" class="mb-12">
            <h2
              id="featured-heading"
              class="text-foreground/60 mb-4 text-xs font-semibold tracking-widest uppercase"
            >
              Featured &amp; latest
            </h2>
            <SectionCarousel entries={entries} section="interview" />
          </section>
          */}

          <section aria-labelledby="all-heading">
            <div class="mb-8">
              <h2
                id="all-heading"
                class="mb-4 text-2xl font-bold tracking-wide"
              >
                All Interviews ({totalCount})
              </h2>
            </div>
            <div class="grid auto-rows-fr gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {entries.map(e => (
                <a
                  href={getRelativeLocaleUrl(locale, `interview/${e.id}`)}
                  class="group border-accent bg-background hover:shadow-accent/20 flex h-56 flex-col rounded-lg border p-6 transition-all hover:-translate-y-1 hover:shadow-xl"
                >
                  <div class="flex flex-col items-center gap-4 text-center">
                    <img
                      src="/icon2.png"
                      alt="interview icon"
                      class="h-10 w-10 object-contain"
                    />
                    <h3 class="group-hover:text-accent text-lg leading-snug font-bold transition-colors">
                      {e.data.title}
                    </h3>
                  </div>
                  <div class="text-accent mt-auto text-sm font-medium opacity-0 transition-opacity group-hover:opacity-100">
                    Read more →
                  </div>
                </a>
              ))}
            </div>
          </section>
        </>
      )
    }
  </Main>
  <Footer />
</Layout>
