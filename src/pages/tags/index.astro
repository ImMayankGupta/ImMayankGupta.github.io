---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getMultiCollectionEntries";
import config from "@/config";

const tags = await getUniqueTags();
---

<Layout
  title={`Tags | ${config.site.title}`}
  description="Browse all topics and tags across automation frameworks, developer resources, and interview guides."
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle="Explore by Tags"
    pageDesc={`Discover articles and guides across ${tags.length} different topics and technologies.`}
  >
    <ul class="flex flex-wrap gap-3 py-4">
      {
        tags.map(({ tag, tagName, count }) => (
          <Tag {tag} {tagName} {count} size="base" />
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
