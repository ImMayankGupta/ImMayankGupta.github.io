---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
// import SectionCarousel from "@/components/SectionCarousel.astro"; // Removed - showing all cards instead
// import SectionEntryCard from "@/components/SectionEntryCard.astro"; // Removed - using custom grid layout
import config from "@/config";

const entries = (
  await getCollection("automation", ({ data }) => !data.draft)
).sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);

const locale = Astro.currentLocale ?? config.site.lang;
const totalCount = entries.length;
---

<Layout
  title={`Automation | ${config.site.title}`}
  description="Automation frameworks, test engineering patterns, and CI/CD recipes."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Automation"
    pageDesc="Frameworks, patterns and CI/CD recipes for test engineering."
  >
    {
      totalCount === 0 ? (
        <p class="text-foreground/70">No entries yet — check back soon.</p>
      ) : (
        <>
          {/* Featured Carousel - Removed
          <section aria-labelledby="featured-heading" class="mb-12">
            <h2
              id="featured-heading"
              class="text-foreground/60 mb-4 text-xs font-semibold tracking-widest uppercase"
            >
              Featured &amp; latest
            </h2>
            <SectionCarousel entries={entries} section="automation" />
          </section>
          */}

          <section aria-labelledby="all-heading">
            <div class="mb-8">
              <h2
                id="all-heading"
                class="mb-4 text-2xl font-bold tracking-wide"
              >
                All Automation ({totalCount})
              </h2>
            </div>
            <div class="grid gap-6 auto-rows-fr sm:grid-cols-2 lg:grid-cols-3">
              {entries.map(e => (
                <a
                  href={getRelativeLocaleUrl(locale, `automation/${e.id}`)}
                  class="group border-accent bg-background flex h-56 flex-col rounded-lg border p-6 transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-accent/20"
                >
                  <div class="flex flex-col items-center gap-4 text-center">
                    <img src="/icon2.png" alt="automation icon" class="w-10 h-10 object-contain" />
                    <h3 class="group-hover:text-accent text-lg font-bold leading-snug transition-colors">
                      {e.data.title}
                    </h3>
                  </div>
                  <div class="text-accent mt-auto text-sm font-medium opacity-0 transition-opacity group-hover:opacity-100">
                    Read more →
                  </div>
                </a>
              ))}
            </div>
          </section>
        </>
      )
    }
  </Main>
  <Footer />
</Layout>
